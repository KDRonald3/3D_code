{
  "name": "horizon-map",
  "displayName": "Horizon Map",
  "description": "Rust free-function codebase map for the Horizon IDE.",
  "version": "0.1.0",
  "publisher": "horizon",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:horizon.map.open",
    "onCommand:horizon.map.toggle",
    "onCommand:horizon.map.analyse",
    "onCommand:horizon.map.show",
    "onCommand:horizon.map.hide",
    "onCommand:horizon.map.analyseWorkspace",
    "onCommand:horizon.inspection.triggerSuggest",
    "onView:horizon.map.view"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "rust-lang.rust-analyzer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "horizon.map.open",
        "title": "Horizon: Open Map",
        "category": "Horizon",
        "icon": "$(map)"
      },
      {
        "command": "horizon.map.toggle",
        "title": "Horizon: Toggle Map ↔ Classic",
        "category": "Horizon",
        "icon": "$(map)"
      },
      {
        "command": "horizon.map.analyse",
        "title": "Horizon: Analyse Workspace",
        "category": "Horizon",
        "icon": "$(refresh)"
      },
      {
        "command": "horizon.map.show",
        "title": "Horizon: Show Map",
        "category": "Horizon"
      },
      {
        "command": "horizon.map.hide",
        "title": "Horizon: Show Classic",
        "category": "Horizon"
      },
      {
        "command": "horizon.map.analyseWorkspace",
        "title": "Horizon: Analyse Workspace (alias)",
        "category": "Horizon"
      },
      {
        "command": "horizon.inspection.triggerSuggest",
        "title": "Horizon: Trigger Inspection Completions",
        "category": "Horizon"
      }
    ],
    "keybindings": [
      {
        "command": "horizon.map.toggle",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus || horizon.map.visible || !editorFocus"
      },
      {
        "command": "horizon.map.open",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "configuration": {
      "title": "Horizon Map",
      "properties": {
        "horizon.map.sidecarUrl": {
          "type": "string",
          "default": "",
          "description": "Attach to an already-running horizon-server (e.g. http://127.0.0.1:PORT). Overrides spawn when set. Env HORIZON_SIDECAR_URL also works. Must be loopback only."
        },
        "horizon.map.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the horizon-server binary. Env HORIZON_SERVER_PATH also works. Prefer target/release/horizon-server when building from this repo."
        },
        "horizon.map.cargoWorkspace": {
          "type": "string",
          "default": "",
          "description": "Horizon Cargo workspace root (contains crates/horizon-server). Used to find target/release/horizon-server or run `cargo run -p horizon-server`."
        },
        "horizon.map.autoStartSidecar": {
          "type": "boolean",
          "default": true,
          "description": "Warm-start or attach the horizon-server sidecar on extension activate. If false, the sidecar starts on first Analyse."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "horizon",
          "title": "Horizon",
          "icon": "media/horizon-activity.svg"
        }
      ]
    },
    "views": {
      "horizon": [
        {
          "type": "webview",
          "id": "horizon.map.view",
          "name": "Map",
          "contextualTitle": "Horizon Map",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "horizon.map.analyse",
          "when": "view == horizon.map.view",
          "group": "navigation"
        },
        {
          "command": "horizon.map.toggle",
          "when": "view == horizon.map.view",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "horizon.map.open"
        },
        {
          "command": "horizon.map.toggle"
        },
        {
          "command": "horizon.map.analyse"
        },
        {
          "command": "horizon.map.show"
        },
        {
          "command": "horizon.map.hide"
        },
        {
          "command": "horizon.map.analyseWorkspace",
          "when": "false"
        },
        {
          "command": "horizon.inspection.triggerSuggest",
          "when": "horizon.inspection.active"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "preview": "node scripts/preview-server.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
