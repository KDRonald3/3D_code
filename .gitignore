/target

# Scratch target dir used when a background agent builds in parallel
/target-agent

# horizon-types sits outside the workspace, so it builds into its own dir and
# resolves its own lock file rather than sharing the workspace ones
/crates/horizon-types/target
/crates/horizon-types/Cargo.lock

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Generated maps and screenshots used while developing the viewer
/crates/horizon-server/testdata/

# Compiled report; the .tex source is tracked instead
/docs/horizon-report.pdf

# Map produced by a local sidecar analyse run (GET /api/map)
/horizon-map.json

# Horizon IDE — Code-OSS checkout, caches, and local build artifacts
/ide/code-oss/
/ide/vendor/
/ide/.cache/
/ide/**/node_modules/
/ide/**/out/
# Ship compiled horizon-map so vendor sync can activate without a local tsc.
!/ide/extensions/horizon-map/out/
!/ide/extensions/horizon-map/out/**
/ide/**/*.vsix
